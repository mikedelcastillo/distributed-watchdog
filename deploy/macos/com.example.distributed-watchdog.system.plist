<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.distributed-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/distributed-watchdog</string>
    <string>--config</string>
    <string>/usr/local/etc/distributed-watchdog/config.toml</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/usr/local/etc/distributed-watchdog</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/distributed-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/distributed-watchdog.err.log</string>
</dict>
</plist>
